# ============================================================
# Stock Pipeline — Environment Variables Reference
# Copy to .env and fill in your values before starting Docker.
# Never commit the real .env file to version control.
# ============================================================

# ----------------------
# Application
# ----------------------
ENVIRONMENT=development
DEBUG=false

# ----------------------
# PostgreSQL (main pipeline DB)
# ----------------------
# Use 'postgres' for Docker Compose, 'localhost' for local dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stock_pipeline
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change_me_strong_password

# Connection pool (optional — defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Airflow uses a separate database in the same Postgres instance
AIRFLOW_DB=airflow

# ----------------------
# pgAdmin (optional GUI)
# ----------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ----------------------
# Apache Superset
# ----------------------
SUPERSET_SECRET_KEY=change_me_long_random_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin_password
SUPERSET_ADMIN_FIRSTNAME=Stock
SUPERSET_ADMIN_LASTNAME=Pipeline
SUPERSET_ADMIN_EMAIL=admin@stockpipeline.local

# ----------------------
# Airflow
# ----------------------
# Generate fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_32_byte_base64_fernet_key==
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_airflow_webserver_secret
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password

# ----------------------
# MLflow
# ----------------------
# Defaults to http://mlflow:5000 inside the Docker network.
# Override if running MLflow outside of Docker Compose.
MLFLOW_TRACKING_URI=http://mlflow:5000

# ----------------------
# Pipeline behaviour (optional — defaults shown)
# ----------------------
PIPELINE_LOOKBACK_DAYS=30
PIPELINE_BATCH_SIZE=50
ACTIVE_RECOMMENDATION_PROFILES=steady_20p_10d,steady_20p_20d

# ----------------------
# Data source HTTP (optional — defaults shown)
# ----------------------
REQUEST_TIMEOUT=30
MAX_RETRIES=5

# ----------------------
# Alert thresholds (optional — defaults shown)
# ----------------------
ALERT_PRICE_WARNING=4.0
ALERT_PRICE_CRITICAL=8.0
ALERT_VOLATILITY_MULT=2.0
ALERT_VOLUME_MULT=2.5
ALERT_RSI_OVERSOLD=30.0
ALERT_RSI_OVERBOUGHT=70.0

# ----------------------
# Email notifications (disabled by default)
# ----------------------
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail: create an App Password in Google Account settings
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_FROM_EMAIL=alerts@stockpipeline.com
# Comma-separated list of recipients
NOTIFICATION_EMAILS=recipient@example.com

# ----------------------
# Slack notifications (disabled by default)
# ----------------------
NOTIFICATION_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ----------------------
# File paths (optional — derived from PROJECT_ROOT by default)
# ----------------------
# Uncomment and set PROJECT_ROOT to override the auto-detected project root.
# PROJECT_ROOT=/app
